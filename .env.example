# Dummy values only. Copy to .env and configure your own environment.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/knowledge_hub"
NEXT_PUBLIC_COGNITO_USER_POOL_ID="ap-northeast-1_EXAMPLE"
NEXT_PUBLIC_COGNITO_CLIENT_ID="your-app-client-id"
S3_BUCKET_NAME="your-bucket-name"
S3_REGION="ap-northeast-1"
ADMIN_ACCOUNT_EMAIL="admin@example.com"

# API-only host settings are documented in server/.env.example.
# Next.js forwards /api/* to this standalone NestJS server.
API_ORIGIN="http://127.0.0.1:3001"
API_HOST="127.0.0.1"
API_PORT="3001"
