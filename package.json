{
  "name": "knowledge-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:api && concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "build": "npm run build:api && npm run build:web",
    "start": "concurrently -k \"npm:start:web\" \"npm:start:api\"",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "db:seed": "prisma db seed",
    "db:rollback": "tsx prisma/rollback-seed.ts",
    "dev:web": "next dev",
    "dev:api": "concurrently -k \"node scripts/build-api.mjs --watch\" \"node --env-file-if-exists=.env --watch server/dist/main.mjs\"",
    "build:api": "prisma generate --generator client && node scripts/build-api.mjs",
    "start:web": "next start",
    "start:api": "node --env-file-if-exists=.env server/dist/main.mjs",
    "typecheck:api": "tsc -p server/tsconfig.json",
    "test:api": "vitest run --project api",
    "build:web": "next build"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1121.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-fastify": "^12.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "aws-amplify": "^6.20.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.8",
    "jwks-rsa": "^4.1.0",
    "motion": "^13.1.1",
    "next": "16.2.12",
    "oidc-client-ts": "^3.5.0",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-oidc-context": "^3.3.1",
    "react-qr-code": "^2.2.0",
    "react-toastify": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
